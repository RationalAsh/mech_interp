                "cell_id": "b194af7f",
                "cell_type": "code",
                "content": "import importlib.util\nimport sys\nfrom pathlib import Path\n\n\ndef find_script() -> Path:\n    relative_path = Path(\"experiments/01_grokking/scripts/first_pass_grokking.py\")\n    for root in (Path.cwd(), *Path.cwd().parents):\n        candidate = root / relative_path\n        if candidate.is_file():\n            return candidate\n    raise FileNotFoundError(\n        f\"Could not find {relative_path} from {Path.cwd()} or any parent directory.\"\n    )\n\n\nSCRIPT_PATH = find_script()\nmodule_spec = importlib.util.spec_from_file_location(\"first_pass_grokking\", SCRIPT_PATH)\nif module_spec is None or module_spec.loader is None:\n    raise ImportError(f\"Could not load {SCRIPT_PATH}\")\n\ngrokking = importlib.util.module_from_spec(module_spec)\nsys.modules[module_spec.name] = grokking\nmodule_spec.loader.exec_module(grokking)\n\nprint(f\"Loaded implementation from: {SCRIPT_PATH}\")\nprint(f\"Using device: {grokking.DEVICE}\")"
              }
            },
